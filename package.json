{
  "name": "webperf-snippets-docs",
  "private": true,
  "version": "2.0.1",
  "description": "Web Performance Snippets — documentation site",
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "prebuild": "rm -rf .next && node scripts/generate-llms.js && node scripts/generate-page-markdown.mjs && node scripts/generate-webmcp-registry.mjs",
    "check:consistency": "node scripts/check-consistency.js",
    "test:demos": "node --test scripts/demos.test.js",
    "check:emoji": "node scripts/check-emoji.js",
    "test:icons": "node --test lib/rehype-icons.test.js lib/strip-emoji.test.js scripts/check-emoji.test.js",
    "test:support": "node --test lib/browser-support.test.js lib/remark-browser-support.test.js",
    "test:prompt": "node --test lib/snippet-prompt.test.mjs lib/remark-snippet-prompt.test.mjs scripts/eval-prompts/grade.test.mjs scripts/eval-prompts/summary.test.mjs scripts/eval-mcp/grade.test.mjs scripts/eval-mcp/summary.test.mjs",
    "eval:prompts": "node scripts/eval-prompts/run.mjs",
    "eval:mcp": "node scripts/eval-mcp/run.mjs",
    "extension:build": "node scripts/build-extension.mjs",
    "extension:zip": "node scripts/package-extension.mjs",
    "test:extension": "node --test extension/lib/*.test.js lib/snippet-expression.test.mjs",
    "test:extension:e2e": "node scripts/build-extension.mjs && node --test --test-concurrency=1 extension/tests/panel.e2e.test.js extension/tests/package.test.js",
    "test:ci": "node --test scripts/ci-skip-slow-steps.test.js scripts/check-tag-version.test.js",
    "test:diagrams": "vitest run components/diagrams",
    "test:components": "vitest run components lib/page-metadata.test.js lib/analytics.test.js lib/webmcp.test.js",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-demo-heights": "node scripts/generate-demo-heights.mjs",
    "capture:examples": "node scripts/capture-snippet-examples.mjs",
    "generate-skills": "node scripts/generate-skills.js",
    "generate-skills:check": "node scripts/generate-skills.js && git diff --exit-code -- skills dist .claude/skills",
    "test:skills": "node --test scripts/skill-scripts.test.js scripts/skill-guidance.test.js",
    "install-skills": "node scripts/install-skills.js",
    "install-global": "node scripts/install-global.js",
    "install-from-release": "node scripts/install-from-release.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "npm run lint && npm run build",
    "prepare": "git config core.hooksPath .githooks",
    "test": "echo \"No tests configured\"",
    "postbuild": "node scripts/build-search-index.js",
    "test:site": "node --test lib/sitemap-routes.test.js scripts/read-meta.test.js scripts/check-built-snippets.test.js scripts/prerendered-dir.test.js lib/page-markdown.test.mjs lib/markdown-path.test.mjs scripts/generate-llms.test.js lib/page-info.test.js lib/webmcp-registry.test.mjs scripts/example-domains.test.js",
    "check:built-snippets": "node scripts/check-built-snippets.js"
  },
  "keywords": [
    "webperf",
    "performance",
    "perftools",
    "snippets"
  ],
  "author": "Joan Leon | @nucliweb",
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@mdn/browser-compat-data": "^8.1.6",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "next": "^16.4.2",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "terser": "^5.36.0",
    "pagefind": "^1.4.0"
  },
  "overrides": {
    "next-mdx-remote": "^6.0.0",
    "zod": "4.3.6",
    "@xmldom/xmldom": "0.9.12"
  }
}
