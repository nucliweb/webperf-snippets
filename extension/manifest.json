{
  "manifest_version": 3,
  "name": "WebPerf Snippets",
  "version": "0.1.0",
  "description": "Run the WebPerf Snippets on the inspected page from a DevTools panel, and read their results.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://webperf-snippets.net",
  "minimum_chrome_version": "120",
  "devtools_page": "devtools.html",
  "permissions": ["storage"]
}
